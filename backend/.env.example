# ============================================
# APPLICATION ENVIRONMENT
# ============================================
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
API_PREFIX=api
BODY_LIMIT=10mb
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
SHUTDOWN_TIMEOUT=10000
TRUST_PROXY=false

# ============================================
# DATABASE CONFIGURATION (PostgreSQL)
# ============================================
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=agent_issuer
DB_USERNAME=postgres
DB_PASSWORD=your_password_here
DB_SSL=false
DB_MAX_CONNECTIONS=10
DB_IDLE_TIMEOUT=30000
DB_CONNECTION_TIMEOUT=2000
DB_MIGRATIONS_RUN=true

# ============================================
# AUTHENTICATION & SECURITY
# ============================================
JWT_SECRET=your_super_secret_jwt_key_at_least_32_chars_long
JWT_EXPIRES_IN=1h
JWT_ALGORITHM=HS256
JWT_ISSUER=agent-issuer
JWT_AUDIENCE=agent-issuer

REFRESH_TOKEN_SECRET=your_super_secret_refresh_key_at_least_32_chars_long
REFRESH_TOKEN_EXPIRES_IN=7d
REFRESH_TOKEN_REMEMBER_ME_EXPIRES_IN=30d

BCRYPT_ROUNDS=12
PASSWORD_MIN_LENGTH=12
PASSWORD_REQUIRE_SPECIAL_CHAR=true
PASSWORD_REQUIRE_NUMBER=true
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_MAX_ATTEMPTS=5
PASSWORD_LOCKOUT_DURATION=900

SESSION_COOKIE_NAME=session
SESSION_MAX_AGE=86400
SESSION_SECURE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_DOMAIN=

API_KEY_ENABLED=false
API_KEY_HEADER_NAME=x-api-key
API_KEYS=key1,key2,key3

# OAuth Configuration
OAUTH_GOOGLE_ENABLED=false
OAUTH_GOOGLE_CLIENT_ID=your_google_client_id
OAUTH_GOOGLE_CLIENT_SECRET=your_google_client_secret
OAUTH_GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

OAUTH_GITHUB_ENABLED=false
OAUTH_GITHUB_CLIENT_ID=your_github_client_id
OAUTH_GITHUB_CLIENT_SECRET=your_github_client_secret
OAUTH_GITHUB_CALLBACK_URL=http://localhost:3000/auth/github/callback

OAUTH_MICROSOFT_ENABLED=false
OAUTH_MICROSOFT_CLIENT_ID=your_microsoft_client_id
OAUTH_MICROSOFT_CLIENT_SECRET=your_microsoft_client_secret
OAUTH_MICROSOFT_CALLBACK_URL=http://localhost:3000/auth/microsoft/callback
OAUTH_MICROSOFT_TENANT=common

AUTH_RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX_REQUESTS=5
AUTH_RATE_LIMIT_SKIP_SUCCESSFUL=false

REQUIRE_EMAIL_VERIFICATION=false
REQUIRE_2FA=false

# ============================================
# AGENT CONFIGURATION (Aries Framework)
# ============================================
AGENT_WALLET_ID=issuer-wallet
AGENT_WALLET_KEY=your_wallet_key_here_change_me
AGENT_WALLET_STORAGE_TYPE=sqlite
AGENT_WALLET_DATABASE_PATH=./data/wallet.db
AGENT_WALLET_AUTO_PROVISION=true
AGENT_WALLET_BACKUP_ENABLED=false
AGENT_WALLET_BACKUP_INTERVAL=86400

AGENT_NETWORK_ENDPOINTS=http://localhost:3000
AGENT_NETWORK_AUTO_DISCOVER_ENDPOINTS=false
AGENT_NETWORK_PUBLIC_DID_ENDPOINT=
AGENT_NETWORK_ADMIN_ENDPOINT=
AGENT_NETWORK_LABEL=Credential Issuer
AGENT_NETWORK_IMAGE_URL=

AGENT_CONNECTION_TIMEOUT=30000
AGENT_CONNECTION_MAX_RETRIES=3
AGENT_CONNECTION_RETRY_DELAY=1000
AGENT_CONNECTION_AUTO_ACCEPT=true
AGENT_CONNECTION_PROTOCOL_VERSION=1.0

AGENT_MESSAGING_TRANSPORT=http
AGENT_MESSAGING_INBOUND_TRANSPORTS=http
AGENT_MESSAGING_OUTBOUND_TRANSPORTS=http
AGENT_MESSAGING_MAX_MESSAGE_SIZE=1048576
AGENT_MESSAGING_QUEUE_MAX_SIZE=1000

AGENT_AUTO_CREATE_DID=true
AGENT_AUTO_UPDATE=false
AGENT_LOG_LEVEL=info
AGENT_PLUGINS=
AGENT_MAX_CONCURRENT_OPERATIONS=10

# ============================================
# DID CONFIGURATION
# ============================================
DID_ALLOWED_METHODS=key,web,ethr,hedera
DID_DEFAULT_METHOD=key
DID_VERIFICATION_TIMEOUT=10000
DID_CACHE_TTL=300
DID_RESOLVER_URL=
DID_UNIVERSAL_RESOLVER_URL=https://dev.uniresolver.io
DID_HEDERA_NETWORK=testnet
DID_HEDERA_REGISTRY_ADDRESS=
DID_ETHR_NETWORK=mainnet
DID_ETHR_REGISTRY_ADDRESS=
DID_WEB_DOMAIN=localhost

# ============================================
# EMAIL CONFIGURATION
# ============================================
EMAIL_ENABLED=false
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=true
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password
EMAIL_FROM=noreply@example.com
EMAIL_FROM_NAME=Agent Issuer
EMAIL_TEMPLATES_PATH=./templates/email
EMAIL_QUEUE_ENABLED=true
EMAIL_QUEUE_NAME=email-queue
EMAIL_RETRY_ATTEMPTS=3
EMAIL_RETRY_DELAY=5000
EMAIL_TIMEOUT=10000

# ============================================
# LOGGING CONFIGURATION
# ============================================
LOG_LEVEL=info
LOG_FORMAT=json

# File Logging
LOG_FILE_ENABLED=true
LOG_FILE_PATH=./logs
LOG_FILE_FILENAME=app-%DATE%.log
LOG_FILE_LEVEL=info
LOG_FILE_FORMAT=json
LOG_MAX_SIZE=10m
LOG_MAX_FILES=30d
LOG_COMPRESS=true
LOG_MAX_AGE=

# Console Logging
LOG_CONSOLE_ENABLED=true
LOG_CONSOLE_LEVEL=debug
LOG_CONSOLE_FORMAT=pretty
LOG_CONSOLE_COLORS=true

# External Logging
LOG_EXTERNAL_ENABLED=false
LOG_EXTERNAL_SERVICE=sentry
LOG_EXTERNAL_DSN=
LOG_EXTERNAL_LEVEL=error
LOG_EXTERNAL_SAMPLE_RATE=0.1
LOG_EXTERNAL_ENVIRONMENT=development

# Advanced Logging
LOG_CORRELATION_ID_HEADER=x-correlation-id
LOG_REDACT_FIELDS=password,secret,token,authorization
LOG_ENABLE_METRICS=true
LOG_SLOW_QUERY_THRESHOLD=5000

# ============================================
# OPENID4VC CONFIGURATION
# ============================================
OPENID4VC_ISSUER_ENABLED=false
OPENID4VC_ISSUER_ENDPOINT=/openid4vc/issuer
OPENID4VC_ISSUER_BASE_URL=
OPENID4VC_ACCESS_TOKEN_EXPIRES_IN=300
OPENID4VC_CREDENTIAL_OFFER_EXPIRES_IN=3600
OPENID4VC_USER_PIN_ENABLED=true
OPENID4VC_USER_PIN_LENGTH=4
OPENID4VC_BATCH_ISSUANCE_ENABLED=false
OPENID4VC_MAX_BATCH_SIZE=10

OPENID4VC_VERIFIER_ENABLED=false
OPENID4VC_VERIFIER_ENDPOINT=/openid4vc/verifier
OPENID4VC_VERIFIER_BASE_URL=
OPENID4VC_PRESENTATION_REQUEST_EXPIRES_IN=600
OPENID4VC_SUPPORTED_ALGORITHMS=ES256,EdDSA
OPENID4VC_RESPONSE_MODE=direct_post.jwt

# Metadata
OPENID4VC_METADATA_TERMS_OF_SERVICE=
OPENID4VC_METADATA_PRIVACY_POLICY=
OPENID4VC_METADATA_LOGO_URL=
OPENID4VC_METADATA_BACKGROUND_COLOR=#0066CC
OPENID4VC_METADATA_TEXT_COLOR=#FFFFFF

# Compliance
OPENID4VC_COMPLIANCE_REQUIRE_AUDIENCE_VALIDATION=true
OPENID4VC_COMPLIANCE_REQUIRE_ISSUER_VALIDATION=true
OPENID4VC_COMPLIANCE_ALLOWED_ISSUERS=
OPENID4VC_COMPLIANCE_ALLOWED_AUDIENCES=

# ============================================
# CREDENTIAL CONFIGURATION
# ============================================
CREDENTIAL_BATCH_ENABLED=false
CREDENTIAL_MAX_BATCH_SIZE=100
CREDENTIAL_DEFAULT_VALIDITY_DAYS=365

# Format Configuration
CREDENTIAL_SDJWT_ENABLED=true
CREDENTIAL_JWT_ENABLED=false
CREDENTIAL_JWT_ALGORITHM=ES256

# Validation Configuration
CREDENTIAL_REQUIRE_SCHEMA_VALIDATION=false
CREDENTIAL_MAX_FIELD_LENGTH=1000
CREDENTIAL_ALLOWED_DATA_TYPES=string,number,boolean,date,array,object

# Revocation Configuration
CREDENTIAL_REVOCATION_ENABLED=false
CREDENTIAL_REVOCATION_LIST_PATH=./data/revocation-list.json

# Issuance Configuration
CREDENTIAL_REQUIRE_HOLDER_CONSENT=true
CREDENTIAL_ALLOW_DEFERRED_ISSUANCE=false
CREDENTIAL_DEFERRED_ISSUANCE_TIMEOUT=3600

# General Configuration
CREDENTIAL_CONFIG_PATH=./credentials.yaml
CREDENTIAL_AUTO_RELOAD=true
CREDENTIAL_WATCH_FOR_CHANGES=true
CREDENTIAL_CACHE_TTL=300

# ============================================
# DEVELOPMENT OVERRIDES (Optional)
# ============================================
# DEBUG=agent-issuer:*
# NODE_TLS_REJECT_UNAUTHORIZED=0 (for development only!)
# AGENT_ALLOW_INSECURE_HTTP_URLS=true